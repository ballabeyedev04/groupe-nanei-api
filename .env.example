# ── Serveur ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Base de données ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=groupe_nanei
DB_USER=groupe_nanei
DB_PASSWORD=change-me
DB_SSL=false

# ── Authentification admin ───────────────────────────────────────────────
JWT_SECRET=change-me-generer-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h
COOKIE_NAME=gn_admin_token

# Compte admin créé par "npm run seed:admin" (si le compte existe déjà,
# le script est sans effet — voir src/scripts/seedAdmin.js).
ADMIN_EMAIL=admin@groupe-nanei.fr
ADMIN_PASSWORD=change-me
ADMIN_NOM=Administrateur

# ── CORS ──────────────────────────────────────────────────────────────────
# Origine(s) du site web autorisée(s) à appeler l'API avec les cookies
# (séparer par une virgule si plusieurs, ex. prod + preview).
CORS_ORIGIN=http://localhost:5173

# ── E-mail (Resend) ───────────────────────────────────────────────────────
# Clé API Resend (https://resend.com/api-keys) — jamais exposée côté web.
RESEND_API_KEY=re_change_me
# Adresse d'expédition : le domaine doit être vérifié dans Resend, sinon
# les envois échouent silencieusement en production.
RESEND_FROM="Groupe Nanei <contact@groupe-nanei.fr>"
# Boîte interne qui reçoit une notification à chaque nouvelle demande de devis.
ADMIN_NOTIFICATION_EMAIL=contact@groupe-nanei.fr
